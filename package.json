{
  "name": "bb-plugin-github-actions",
  "version": "0.1.0",
  "description": "BB plugin: live GitHub Actions runs, manual workflow runs with inputs, job logs, reruns, and agent investigations.",
  "license": "MIT",
  "author": "pers0na2dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pers0na2dev/bb-github-actions.git"
  },
  "homepage": "https://github.com/pers0na2dev/bb-github-actions#readme",
  "keywords": [
    "bb",
    "bb-plugin",
    "github-actions",
    "ci",
    "cd"
  ],
  "type": "module",
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit -p ."
  },
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.49"
  },
  "bb": {
    "name": "GitHub Actions",
    "description": "Live GitHub Actions runs for your projects: start any workflow with inputs, watch job logs, rerun failures, hand them to an agent, or send them to BB threads.",
    "branding": {
      "icon": "Workflow"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2"
  }
